# ArduinoNRF nRF52840 board family - Linux udev rules
#
# Grants the `dialout` group read/write access to the USB CDC ports of all
# supported bootloaders and runtimes, so the 1200-bps touch, adafruit-nrfutil
# serial DFU, and the USB-CDC GDB-stub bridge work without `sudo`.
#
# Install (Ubuntu / Debian / Fedora / Arch):
#   sudo cp 99-arduinonrf.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#   sudo usermod -a -G dialout $USER       # then log out / log back in
#
# Adjust GROUP="dialout" to "plugdev" or "uucp" on distros that prefer those.

# Adafruit-fork bootloaders (nice!nano v2 / SuperMini / AliExpress ProMicro clones)
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="00b3", MODE="0664", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="00b4", MODE="0664", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="0029", MODE="0664", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="002a", MODE="0664", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="4029", MODE="0664", GROUP="dialout"

# Seeed XIAO nRF52840 / XIAO Sense (Adafruit-fork under Seeed VID)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2886", ATTRS{idProduct}=="0044", MODE="0664", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2886", ATTRS{idProduct}=="8044", MODE="0664", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2886", ATTRS{idProduct}=="0045", MODE="0664", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2886", ATTRS{idProduct}=="8045", MODE="0664", GROUP="dialout"

# Makerdiary Pitaya Go (Adafruit-fork)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2886", ATTRS{idProduct}=="f00e", MODE="0664", GROUP="dialout"

# nRFMicro (joric, pid.codes 1209)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="5284", MODE="0664", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="5285", MODE="0664", GROUP="dialout"

# Nordic Open DFU (nRF52840 USB Dongle / PCA10059) - flashed with nrfutil
SUBSYSTEM=="tty", ATTRS{idVendor}=="1915", ATTRS{idProduct}=="521f", MODE="0664", GROUP="dialout"

# Also tag USB devices so a future userspace can use libusb without root.
SUBSYSTEM=="usb", ATTRS{idVendor}=="239a", MODE="0664", GROUP="dialout"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2886", MODE="0664", GROUP="dialout"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1209", MODE="0664", GROUP="dialout"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1915", MODE="0664", GROUP="dialout"
