# ============================================================
# Caches and per-developer scratch dirs (regenerated by tooling)
# ============================================================
.arduino-ci-sketchbook/
.arduino-cli-user-test/
.arduino15-install-test/
.arduino15-install-test-clean/
.external/
.nius-verify-cache/
build/
drivers/
# Ad-hoc NimBLE bring-up build dirs (.build-nimble-host-*, -controller-*, etc.)
.build*/

# Platform release archives are produced by
# tools/release/build_platform_archive.py and uploaded to GitHub Releases.
# Do not commit them into the tree — the canonical hosting is the release
# page that package_arduinonrf_index.json points to.
dist/

# ============================================================
# Build / upload / validation logs (regenerated each run)
# ============================================================
build_output.txt
build_target*.log
upload_output.txt
upload_live.log
upload_log.txt
*.tmp.log
*.runlog

# ============================================================
# Per-developer arduino-cli configs and ad-hoc test scratch
# (the canonical CI config is .arduino-ci.yaml; do NOT commit
# personal arduino-cli.*.yaml files with hardcoded user paths)
# ============================================================
arduino-cli.local.yaml
arduino-cli.install-test*.yaml

# ============================================================
# Legacy dev-only validation scripts (superseded by
# scripts/verify_promicro_usbcdc_upload_behavior.ps1 and
# scripts/hardware_upload_minimal_usb.ps1). Pattern guards
# against accidental re-tracking from old session checkouts.
# ============================================================
/check_ports.py
/complete_test.py
/full_test.bat
/monitor_ports.py
/run_all_tasks.py
/run_tests.ps1
/run_validation.py
/validate_*.py
/validate_*.bat
/validation.bat
/validation_*.py
/FILES_CREATED.md
/compile-plan-summary.txt

# ============================================================
# Python tooling artifacts
# ============================================================
.venv/
.vscode/
__pycache__/
*.py[cod]
.pytest_cache/

# ============================================================
# Dev-only BLE bring-up / WinRT debug scratch (not needed by users).
# These are ad-hoc probes and host-side test drivers used while
# debugging the NimBLE stack; the shipped package does not need them.
# ============================================================
tools/nimble/
tools/tmp_*.py
tools/clear_ble_device_cache.ps1
scripts/win_serial_inventory.py
*.etl
*.gdb
*_log.txt

# Debug-instrumented BLE example sketches (reference internal debug
# globals like g_txhdr/g_rxatt; for bring-up only, not user-facing).
hardware/arduinonrf/nrf52/libraries/NimBLE/examples/NimBLECentralDbg/
hardware/arduinonrf/nrf52/libraries/NimBLE/examples/NimBLEPeriphDbg/
hardware/arduinonrf/nrf52/libraries/NimBLE/examples/BleCentralProbe/
hardware/arduinonrf/nrf52/libraries/NimBLE/examples/BleCentralLoopbackProbe/
hardware/arduinonrf/nrf52/libraries/NimBLE/examples/NimBLEPeripheralTest/

# ============================================================
# OS / editor noise
# ============================================================
.DS_Store
Thumbs.db
*.swp
*~
